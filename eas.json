{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "24.15.0",
      "pnpm": "11.1.2"
    },
    "preview": {
      "distribution": "internal",
      "node": "24.15.0",
      "pnpm": "11.1.2"
    },
    "production": {
      "autoIncrement": true,
      "node": "24.15.0",
      "pnpm": "11.1.2"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
