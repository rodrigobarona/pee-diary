{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:site",
  "outputDirectory": "site/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- site _docs/legal vercel.json assets/images/icon.png assets/images/favicon.png",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^(pt|PT).*" }],
      "destination": "/pt",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^(es|ES).*" }],
      "destination": "/es",
      "permanent": false
    },
    { "source": "/", "destination": "/en", "permanent": false },
    {
      "source": "/:page(privacy|terms|privacy-choices)",
      "has": [{ "type": "header", "key": "accept-language", "value": "^(pt|PT).*" }],
      "destination": "/pt/:page",
      "permanent": false
    },
    {
      "source": "/:page(privacy|terms|privacy-choices)",
      "has": [{ "type": "header", "key": "accept-language", "value": "^(es|ES).*" }],
      "destination": "/es/:page",
      "permanent": false
    },
    {
      "source": "/:page(privacy|terms|privacy-choices)",
      "destination": "/en/:page",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
